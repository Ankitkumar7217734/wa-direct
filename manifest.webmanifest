{
  "name": "WA Direct",
  "short_name": "WA Direct",
  "description": "Open any WhatsApp chat instantly without saving the contact",
  "start_url": "/wa-direct/",
  "scope": "/wa-direct/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#030703",
  "theme_color": "#030703",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "social", "productivity"],
  "share_target": {
    "action": "/wa-direct/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
